# RideHail Backend - Environment Variables
# Copy to .env and fill values

PORT=4000
NODE_ENV=development

# Database (PostgreSQL) - REQUIRED
DATABASE_URL=postgresql://user:password@localhost:5432/ridehail

# JWT - REQUIRED (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=

# CORS (comma-separated origins or * for dev)
CORS_ORIGIN=*

# Logging
LOG_LEVEL=info
LOG_DIR=logs

# Stripe (optional - for card payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio (REQUIRED for production - SMS/OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Firebase (optional - for push notifications)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Google Maps (optional - for accurate distance/duration)
GOOGLE_MAPS_API_KEY=

# Rate Limiting (optional - defaults shown)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
# AUTH_RATE_LIMIT_MAX=5
# OTP_RATE_LIMIT_MAX=3
